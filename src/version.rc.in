#include <windows.h>

#define VER_FILEVERSION    @MODSECURITYIIS_VERSION_MAJOR@,@MODSECURITYIIS_VERSION_MINOR@,@MODSECURITYIIS_VERSION_PATCH@,0
#define VER_PRODUCTVERSION VER_FILEVERSION

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ModSecurityIIS"
            VALUE "FileDescription",  "ModSecurity WAF module for IIS"
            VALUE "FileVersion",      "@MODSECURITYIIS_VERSION_FULL@"
            VALUE "InternalName",     "modsecurityiis"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "modsecurityiis.dll"
            VALUE "ProductName",      "ModSecurityIIS"
            VALUE "ProductVersion",   "@MODSECURITYIIS_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
